# Gemeinsames Geheimnis zwischen Frontend-Proxy und Backend (frei wählbar, lang).
BACKEND_API_KEY=
# Airtable: NEUE, eigene Base für OG Scale. Ohne diese Werte läuft ein
# flüchtiger Demo-Speicher (Daten weg nach Neustart).
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# KI für Nischen
OPENROUTER_API_KEY=
CREATIVE_MODEL=openai/gpt-4o
# Kleine SQL-Datenbank für Aufträge und (später) den AliRemote-Plan.
# Leer = SQLite-Datei unter backend/var/. Produktion: Postgres-URL.
DATABASE_URL=
# Erlaubte Frontend-Adresse(n), kommagetrennt
CORS_ORIGINS=http://localhost:3000
# 1 = Beispiel-Model und -Nischen in den Demo-Speicher legen
DEMO_SEED=0
